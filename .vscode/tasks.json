{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"label": "npm: build",
			"detail": "npm run build:server && npm run build:client && npm run build:vendor"
		},
		{
			"type": "npm",
			"script": "build:client",
			"problemMatcher": [],
			"label": "npm: build:client"
		},
		{
			"type": "npm",
			"script": "build:server",
			"problemMatcher": ["$tsc"],
			"label": "npm: build:server"
		},
		{
			// Builds the plugin, starts the local Jellyfin (dev/jellyfin/compose.yaml) and sets it up. Idempotent.
			"type": "npm",
			"script": "dev:jellyfin",
			"problemMatcher": [],
			"label": "npm: dev:jellyfin"
		},
		{
			"type": "npm",
			"script": "dev:jellyfin:plugin",
			"problemMatcher": [],
			"label": "npm: dev:jellyfin:plugin",
			"detail": "Rebuild the HAPPY plugin and restart the local Jellyfin"
		},
		{
			"type": "npm",
			"script": "dev:jellyfin:down",
			"problemMatcher": [],
			"label": "npm: dev:jellyfin:down"
		},
		{
			// esbuild watch: rebuilds public/js on every change; the local Jellyfin serves it straight from disk.
			"type": "npm",
			"script": "dev:client",
			"label": "npm: dev:client",
			"isBackground": true,
			"problemMatcher": {
				"owner": "esbuild",
				"pattern": { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
				"background": { "activatesOnStart": true, "beginsPattern": "^\\[watch\\] build started", "endsPattern": "^(Watching |\\[watch\\] build finished)" }
			}
		},
		{
			"type": "npm",
			"script": "dev:css",
			"label": "npm: dev:css",
			"isBackground": true,
			"problemMatcher": {
				"owner": "sass",
				"pattern": { "regexp": "^Error: (.*)$", "message": 1 },
				"background": { "activatesOnStart": true, "beginsPattern": "^\\[\\d", "endsPattern": "(Compiled |Sass is watching)" }
			}
		},
		{
			// Everything the "HAPPY in local Jellyfin" launch needs: Jellyfin with the plugin, vendor assets, CSS and JS watches.
			"label": "Local Jellyfin: start with client watch",
			"dependsOrder": "sequence",
			"dependsOn": ["npm: dev:jellyfin", "npm: build:vendor", "npm: build:css", "Client watch"],
			"problemMatcher": []
		},
		{
			"label": "Client watch",
			"dependsOn": ["npm: dev:client", "npm: dev:css"],
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "build:vendor",
			"problemMatcher": [],
			"label": "npm: build:vendor"
		},
		{
			"type": "npm",
			"script": "build:css",
			"problemMatcher": [],
			"label": "npm: build:css"
		}
	]
}
