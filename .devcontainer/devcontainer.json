{
  "name": "docker-haptic-player",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26-trixie",
  // disables SELinux relabeling of the bind mount, needed on Fedora/RHEL hosts running SELinux enforcing
  "runArgs": [
    "--security-opt",
    "label=disable"
  ],
  // No ports to forward: the local dev Jellyfin (:8097) and DG-Lab relay (:8070) run as containers
  // on the host's Docker (npm run dev:jellyfin) and publish their ports there directly.
  // Mounts the repo at the same absolute path as on the host. Claude Code keys its sessions by
  // working directory, so this lets `claude --resume` pick up sessions started on the host.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  // Makes sure ~/.claude exists on the host, otherwise the bind mount below fails
  "initializeCommand": "mkdir -p \"$HOME/.claude\"",
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,readonly",
    // Shares Claude Code sessions, credentials and settings with the host
    "type=bind,source=${localEnv:HOME}/.claude,target=/home/node/.claude"
  ],
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "postStartCommand": "git lfs install && git lfs pull",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  }
}