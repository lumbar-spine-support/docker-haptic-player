{
  "name": "docker-haptic-player",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26-trixie",
  // disables SELinux relabeling of the bind mount, needed on Fedora/RHEL hosts running SELinux enforcing
  "runArgs": [
    "--security-opt",
    "label=disable"
  ],
  "forwardPorts": [
    3000
  ],
  // Publishes the port on the host's 0.0.0.0 rather than only localhost, so a phone on the
  // same network can reach the dev server. forwardPorts alone is loopback-only.
  "appPort": [
    "3000:3000"
  ],
  "portsAttributes": {
    "3000": {
      "label": "HAPPY"
    }
  },
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,readonly"
  ],
  "postCreateCommand": "mkdir -p media config; sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg; npm install; sudo npx --yes playwright install-deps chromium; npx --yes playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/postfinance/devcontainer-features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": "false"
    }
  }
}