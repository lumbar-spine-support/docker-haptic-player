{
  "name": "docker-haptic-player",
  "version": "0.15.0",
  "description": "HAPPY is a self-hosted haptic player for audio and video files.",
  "license": "GPL-3.0-or-later",
  "main": "dist/server/index.js",
  "scripts": {
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "npm run build:css && NODE_ENV=production node scripts/build-client.js --minify --sourcemap",
    "dev:client": "node scripts/build-client.js --sourcemap --watch",
    "build:vendor": "node scripts/copy-vendor-assets.js",
    "build": "npm run build:server && npm run build:client && npm run build:vendor",
    "start": "node dist/server/index.js",
    "clean": "rm -rf dist public/js public/vendor public/css/*.css public/auth/*.css public/auth/login.js*",
    "build:css": "npx sass public/css/app.scss:public/css/app.css public/css/auth.scss:public/auth/auth.css --style=compressed --quiet-deps --silence-deprecation=import,global-builtin,if-function,color-functions",
    "test": "NODE_ENV=test node --import tsx --test $(find test/server test/client -name '*.test.ts')",
    "test:coverage": "mkdir -p coverage && NODE_ENV=test node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info $(find test/server test/client -name '*.test.ts')",
    "test:watch": "NODE_ENV=test node --import tsx --test --watch $(find test/server test/client -name '*.test.ts')",
    "screenshot": "node scripts/screenshot-app.js",
    "sandbox": "node sandbox/serve.js",
    "docs:env": "node --import tsx scripts/update-env-docs.js"
  },
  "dependencies": {
    "@videojs/html": "^10.0.1",
    "compression": "^1.8.2",
    "dglab-kit": "^1.0.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.2",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "buttplug": "^5.0.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-tsconfig-paths": "^1.0.2",
    "nodemon": "^3.0.3",
    "playwright": "^1.63.0",
    "sass": "^1.89.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true
  }
}
