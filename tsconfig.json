{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "types": [
            "node"
        ],
        "noEmit": true
    },
    "include": [
        "@/**/*",
        "src/**/*",
        "test/**/*",
        "scripts/**/*",
        "dglab-relay/src/**/*",
        "dglab-relay/test/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}